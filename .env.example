# SentinelSec Environment Configuration
# Copy this file to .env for local development

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="SentinelSec Platform"
API_V1_PREFIX=/api

# Security & CORS
# List of origins allowed to access the API (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sentinelsec_user
POSTGRES_PASSWORD=sentinelsec_secure_password_replace_in_prod
POSTGRES_DB=sentinelsec_db

# Asynchronous SQLAlchemy connection string (for FastAPI asyncpg engine)
DATABASE_URL=postgresql+asyncpg://sentinelsec_user:sentinelsec_secure_password_replace_in_prod@postgres:5432/sentinelsec_db

# Synchronous connection string (used by Alembic migrations)
SYNC_DATABASE_URL=postgresql+psycopg://sentinelsec_user:sentinelsec_secure_password_replace_in_prod@postgres:5432/sentinelsec_db

# Redis & Celery Task Queue (Infrastructure Scaffolding)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
